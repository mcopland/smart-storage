{
  "name": "smart-storage",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "build:wasm": "wasm-pack build crates/engine --target web",
    "ensure:wasm": "node scripts/ensure-wasm.mjs",
    "dev": "npm run ensure:wasm && vite",
    "build": "npm run ensure:wasm && tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "npm run ensure:wasm && vitest run",
    "typecheck": "npm run ensure:wasm && tsc --noEmit",
    "lint": "eslint . --max-warnings 0"
  },
  "dependencies": {
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^25.9.5",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "@vitest/web-worker": "^4.1.10",
    "eslint": "^10.6.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "happy-dom": "^20.10.6",
    "prettier": "^3.9.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.62.1",
    "vite": "^8.1.4",
    "vitest": "^4.1.10"
  }
}
